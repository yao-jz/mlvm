pragma solidity ^0.8.15;

import { Test } from "forge-std/Test.sol";
import { MLClaim } from "../src/MLClaim.sol";

/// @title MLClaimTest
/// @notice Checks that the chain reads back exactly the answer the model computed.
///
///         This is the step that turns a fault proof into a claim about an inference. The
///         dispute game can settle "state A went to state B"; what makes that useful is being
///         able to say "and therefore the answer was Y", read out of B rather than taken on
///         trust from a guest's stdout.
///
///         `ml-claim-fixture.json` is generated by actually running the MLP inside the VM
///         (`bin/mlvm ml-claim --path examples/build/mlp --fixture ...`), so every value here
///         is what the network really produced.
contract MLClaimTest is Test {
    MLClaim internal claim;

    bytes internal stateData;
    bytes internal proof;
    bytes32 internal answerHash;
    bytes32 internal preState;
    bytes32 internal postState;
    bytes internal noResultState;
    bytes internal noResultProof;

    function setUp() public {
        string memory json = vm.readFile("test/ml-claim-fixture.json");
        // parseJsonBytes, not abi.decode(parseJson). And the answer arrives as a *hash*
        // rather than as bytes: Foundry guesses a JSON value's type from its shape and gets
        // a 40-byte hex string wrong, handing back the ASCII of the string. That reads as a
        // contract bug when it is a harness bug. A bytes32 is never mis-guessed, and
        // comparing hashes is what a dispute game would do anyway.
        stateData = vm.parseJsonBytes(json, ".stateData");
        proof = vm.parseJsonBytes(json, ".proof");
        answerHash = vm.parseJsonBytes32(json, ".answerHash");
        preState = vm.parseJsonBytes32(json, ".preState");
        postState = vm.parseJsonBytes32(json, ".postState");

        // A run of a guest that never commits a result, for the negative case.
        noResultState = vm.parseJsonBytes(json, ".noResultState");
        noResultProof = vm.parseJsonBytes(json, ".noResultProof");
        claim = new MLClaim();
    }

    /// @notice The answer read out of the settled state must be the one the model computed.
    function test_readAnswer_matchesGuest_succeeds() public {
        bytes memory got = claim.readAnswer(stateData, proof);
        assertEq(keccak256(got), answerHash);
    }

    /// @notice And it must decode as what the network actually said: four softmax
    ///         probabilities summing to one, and the argmax that follows from them.
    function test_readAnswer_decodesAsProbabilities_succeeds() public {
        bytes memory got = claim.readAnswer(stateData, proof);
        assertEq(got.length, 40, "4 doubles plus an argmax");

        uint256 sum;
        uint256 best;
        uint256 bestIdx;
        for (uint256 i = 0; i < 4; i++) {
            uint64 bits = _le64At(got, i * 8);
            uint256 scaled = _f64ToScaled(bits); // fixed point, 1e18
            sum += scaled;
            if (scaled > best) {
                best = scaled;
                bestIdx = i;
            }
        }
        // Softmax outputs are a distribution. Allow a few ULP of slack, not a percentage.
        assertApproxEqAbs(sum, 1e18, 1e6, "probabilities must sum to 1");
        assertEq(_le64At(got, 32), bestIdx, "committed argmax must match the probabilities");
    }

    /// @notice A claim binds what was run to what came out, in one word.
    function test_claimId_bindsEverything_succeeds() public {
        bytes memory answer = claim.readAnswer(stateData, proof);
        bytes32 id = claim.claimId(preState, postState, answer);
        assertTrue(id != bytes32(0));
        // Changing any of the three changes the claim.
        assertTrue(id != claim.claimId(bytes32(uint256(preState) ^ 1), postState, answer));
        assertTrue(id != claim.claimId(preState, bytes32(uint256(postState) ^ 1), answer));

        bytes memory tampered = answer;
        tampered[0] = bytes1(uint8(tampered[0]) ^ 0xff);
        assertTrue(id != claim.claimId(preState, postState, tampered));
    }

    /// @notice A machine that has not halted, or that faulted, has no answer to read. Its
    ///         result window may hold a half-written value from a previous step.
    function test_readAnswer_notHalted_reverts() public {
        bytes memory s = stateData;
        s[81] = 0x00; // exited = false
        vm.expectRevert(MLClaim.MachineNotHalted.selector);
        claim.readAnswer(s, proof);
    }

    function test_readAnswer_faulted_reverts() public {
        bytes memory s = stateData;
        s[80] = 0x01; // exit code 1
        vm.expectRevert(abi.encodeWithSelector(MLClaim.MachineFaulted.selector, uint8(1)));
        claim.readAnswer(s, proof);
    }

    /// @notice The answer has to come from the state's own memory root. Without this check a
    ///         claimant could pair a real execution with somebody else's answer.
    function test_readAnswer_wrongProof_reverts() public {
        bytes memory bad = proof;
        bad[100] = bytes1(uint8(bad[100]) ^ 0xff);
        vm.expectRevert(MLClaim.MemProofMismatch.selector);
        claim.readAnswer(stateData, bad);
    }

    /// @notice A guest that never committed a result must not look like one that committed an
    ///         empty answer — which is what an untouched, all-zero page reads as.
    ///
    ///         This uses a real run of a guest that never calls `mlvm_commit_result`, so the
    ///         branch is genuinely valid and the magic check is the thing being tested.
    ///         Zeroing bytes in a good proof would only exercise the branch check.
    function test_readAnswer_noResultCommitted_reverts() public {
        vm.expectRevert(MLClaim.NoResultCommitted.selector);
        claim.readAnswer(noResultState, noResultProof);
    }

    /// @notice Little-endian uint64 out of a byte string, the way the VM stores it.
    function _le64At(bytes memory b, uint256 off) internal pure returns (uint64 v) {
        for (uint256 i = 0; i < 8; i++) {
            v |= uint64(uint8(b[off + i])) << uint64(8 * i);
        }
    }

    /// @notice IEEE-754 double to 1e18 fixed point, for values in [0, 1). Enough to check
    ///         that a softmax looks like a softmax; not a general conversion.
    function _f64ToScaled(uint64 bits) internal pure returns (uint256) {
        uint256 mantissa = (bits & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
        int256 exp = int256(uint256((bits >> 52) & 0x7FF)) - 1023 - 52;
        if (exp >= 0) return (mantissa << uint256(exp)) * 1e18;
        uint256 shift = uint256(-exp);
        if (shift > 200) return 0;
        return (mantissa * 1e18) >> shift;
    }
}
