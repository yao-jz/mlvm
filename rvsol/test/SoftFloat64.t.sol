pragma solidity 0.8.15;

import {Test} from "forge-std/Test.sol";
import {stdJson} from "forge-std/StdJson.sol";
import {SoftFloat64} from "src/SoftFloat64.sol";

/// @notice Differential test of the Yul IEEE-754 port against the Go implementation.
///
/// The vectors in softfloat-vectors.json are generated by
/// `bin/mlvm softfloat-vectors --out rvsol/test/softfloat-vectors.json`, which computes every expected result with
/// the same `rvgo/comp` code the off-chain VM uses. If this test passes, the Yul agrees
/// with the VM on every case the generator covers - which is the only claim that matters,
/// since a fraud proof is only sound when the two agree exactly.
///
/// The vectors deliberately over-sample the branchy paths: subnormals, exponent
/// differences across the full range, round-to-nearest-even ties, NaN and infinity.
contract SoftFloat64_Test is Test {
    using stdJson for string;

    /// @notice Every generated vector must reproduce exactly.
    function test_differentialAgainstGo() public {
        string memory raw = vm.readFile("test/softfloat-vectors.json");
        uint256[] memory as_ = raw.readUintArray(".a");
        uint256[] memory bs = raw.readUintArray(".b");
        uint256[] memory sums = raw.readUintArray(".sum");

        assertEq(as_.length, bs.length);
        assertEq(as_.length, sums.length);
        assertGt(as_.length, 1000, "expected a substantial vector set");

        for (uint256 i = 0; i < as_.length; i++) {
            uint64 got = SoftFloat64.addInternal(uint64(as_[i]), uint64(bs[i]));
            if (got != uint64(sums[i])) {
                emit log_named_uint("vector index", i);
                emit log_named_bytes32("a", bytes32(as_[i]));
                emit log_named_bytes32("b", bytes32(bs[i]));
                emit log_named_bytes32("expected", bytes32(sums[i]));
                emit log_named_bytes32("got", bytes32(uint256(got)));
                fail();
            }
        }
        emit log_named_uint("vectors checked", as_.length);
    }

    /// @notice Commutativity, which IEEE-754 addition guarantees for non-NaN operands.
    ///         A cheap property that catches asymmetric handling of the two arguments.
    function testFuzz_commutative(uint64 a, uint64 b) public {
        // Skip NaN: the standard does not require a particular NaN payload, and this
        // implementation canonicalises, so commutativity holds trivially but says nothing.
        vm.assume(!_isNaN(a) && !_isNaN(b));
        assertEq(SoftFloat64.addInternal(a, b), SoftFloat64.addInternal(b, a));
    }

    /// @notice x + 0 == x, except that -0 + +0 == +0.
    function testFuzz_addZeroIdentity(uint64 a) public {
        vm.assume(!_isNaN(a));
        vm.assume(a != 0x8000000000000000); // -0 + +0 is +0, not -0
        assertEq(SoftFloat64.addInternal(a, 0), a);
    }

    /// @notice x + (-x) == +0 for finite x.
    function testFuzz_selfCancellation(uint64 a) public {
        vm.assume(!_isNaN(a) && !_isInf(a));
        assertEq(SoftFloat64.addInternal(a, a ^ 0x8000000000000000), 0);
    }

    // ---------------------------------------------------------------- gas

    /// @notice Gas for one FADD.D, measured across operand classes. This is a component
    ///         cost, not the cost of a complete floating-point dispute.
    function test_gas_profile() public view {
        uint64[2][6] memory cases = [
            [uint64(0x3FF0000000000000), uint64(0x4000000000000000)], // 1.0 + 2.0
            [uint64(0x400921FB54442D18), uint64(0xC00921FB54442D18)], // pi + -pi, full cancellation
            [uint64(0x0000000000000001), uint64(0x0000000000000001)], // subnormal + subnormal
            [uint64(0x7FEFFFFFFFFFFFFF), uint64(0x7FEFFFFFFFFFFFFF)], // overflow to infinity
            [uint64(0x3FF0000000000000), uint64(0x0000000000000001)], // huge exponent difference
            [uint64(0x7FF8000000000000), uint64(0x3FF0000000000000)]  // NaN propagation
        ];
        string[6] memory labels = [
            "1.0 + 2.0            ",
            "pi + -pi (cancel)    ",
            "subnormal + subnormal",
            "overflow to inf      ",
            "large exp difference ",
            "NaN propagation      "
        ];

        // Warm up first: the very first call also pays for memory expansion and cold
        // code, which is not what a step inside RISCV.sol would pay.
        SoftFloat64.addInternal(cases[0][0], cases[0][1]);

        uint256 total;
        for (uint256 i = 0; i < cases.length; i++) {
            uint256 before = gasleft();
            SoftFloat64.addInternal(cases[i][0], cases[i][1]);
            uint256 used = before - gasleft();
            total += used;
            console_log(labels[i], used);
        }
        console_log("mean                 ", total / cases.length);
    }

    function console_log(string memory label, uint256 v) internal view {
        // forge-std's console is not available in a pure view context here, so emit via
        // the standard log opcode path that `forge test -vv` surfaces.
        // solhint-disable-next-line no-console
        address c = 0x000000000000000000636F6e736F6c652e6c6f67;
        (bool ok,) = c.staticcall(abi.encodeWithSignature("log(string,uint256)", label, v));
        ok;
    }

    function _isNaN(uint64 v) internal pure returns (bool) {
        return (v & 0x7FF0000000000000) == 0x7FF0000000000000 && (v & 0x000FFFFFFFFFFFFF) != 0;
    }

    function _isInf(uint64 v) internal pure returns (bool) {
        return (v & 0x7FFFFFFFFFFFFFFF) == 0x7FF0000000000000;
    }
}
