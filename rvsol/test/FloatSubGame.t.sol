pragma solidity ^0.8.15;

import { Test } from "forge-std/Test.sol";
import { FloatSubGame } from "../src/FloatSubGame.sol";

/// @title FloatSubGameTest
/// @notice Holds the sub-game's contract boundary to what the Go VM actually computes.
///
///         `FloatSubGame.sol` has one job on each side: turn (op, a, b) into the nested
///         machine's pre-state hash, and turn a nested post-state back into a float result.
///         Both are consensus-critical in the strictest sense — a one-bit disagreement with
///         `rvgo/fast` means the two disputants are bisecting different machines, and the
///         honest one can lose.
///
///         So nothing here is hand-written. `float-subgame-fixture.json` is generated by
///         actually running the nested machine in Go (`bin/mlvm float-subgame-fixture --out ...`), and
///         every value below is checked against it.
contract FloatSubGameTest is Test {
    FloatSubGame internal game;

    bytes internal imageProof;
    uint256[] internal op;
    uint256[] internal a;
    uint256[] internal b;
    uint256[] internal cc;
    bytes32[] internal preStateHash;
    uint256[] internal result;
    uint256[] internal flags;
    string[] internal names;
    string internal json;

    function setUp() public {
        json = vm.readFile("test/float-subgame-fixture.json");

        bytes32 imageRoot = abi.decode(vm.parseJson(json, ".imageRoot"), (bytes32));
        // parseJsonUint, not abi.decode(parseJson): a 16-nibble hex string decodes as `bytes`,
        // so reading it as a uint256 silently yields the ABI offset word (32) instead of the
        // value. That produced a wrong PC in every derived pre-state and nothing else noticed.
        uint64 entry = uint64(vm.parseJsonUint(json, ".entry"));
        imageProof = abi.decode(vm.parseJson(json, ".imageProof"), (bytes));

        op = vm.parseJsonUintArray(json, ".op");
        a = vm.parseJsonUintArray(json, ".a");
        b = vm.parseJsonUintArray(json, ".b");
        cc = vm.parseJsonUintArray(json, ".c");
        result = vm.parseJsonUintArray(json, ".result");
        flags = vm.parseJsonUintArray(json, ".flags");
        preStateHash = vm.parseJsonBytes32Array(json, ".preStateHash");
        names = vm.parseJsonStringArray(json, ".name");

        game = new FloatSubGame(imageRoot, entry);
    }

    /// @notice The first boundary: the contract must derive exactly the pre-state hash the
    ///         Go VM derives, for every operation.
    ///
    ///         This is what converts "we disagree about FADD.D a, b" into "we disagree about
    ///         this specific RISC-V machine" — after which the existing bisection and
    ///         `RISCV.sol.step` settle it with no float support anywhere.
    function test_nestedPreState_matchesGo_succeeds() public {
        for (uint256 i = 0; i < op.length; i++) {
            bytes32 got = game.nestedPreState(uint64(op[i]), uint64(a[i]), uint64(b[i]), uint64(cc[i]), imageProof);
            assertEq(got, preStateHash[i], names[i]);
        }
    }

    /// @notice The second boundary: the contract must read back exactly the result *and the
    ///         exception flags* the nested machine computed — which is in turn bit-identical to `rvgo/comp` on
    ///         1,522 differential vectors (see `TestFloatSubGameMatchesSoftFloat`).
    function test_nestedResult_matchesGo_succeeds() public {
        for (uint256 i = 0; i < op.length; i++) {
            bytes memory postState = _postState(i);
            bytes memory postProof = _postProof(i);
            (uint64 got, uint64 gotFlags) = game.nestedResult(postState, postProof);
            assertEq(uint256(got), result[i], names[i]);
            // The flags are half the instruction's effect: fcsr is committed state too.
            assertEq(uint256(gotFlags), flags[i], string.concat(names[i], " flags"));
        }
    }

    /// @notice End to end, in one assertion: operands in, IEEE-754 result out, with no
    ///         floating-point arithmetic implemented on chain anywhere in between.
    function test_roundTrip_succeeds() public {
        for (uint256 i = 0; i < op.length; i++) {
            // What the game commits to before the sub-game runs...
            bytes32 pre = game.nestedPreState(uint64(op[i]), uint64(a[i]), uint64(b[i]), uint64(cc[i]), imageProof);
            assertEq(pre, preStateHash[i], names[i]);

            // ...and the post-state's own hash, checked with the same encoding the VM uses,
            // so a claimed post-state cannot be swapped for another machine's.
            bytes memory postState = _postState(i);
            assertTrue(game.stateHash(postState) != bytes32(0));

            (uint64 v, uint64 f) = game.nestedResult(postState, _postProof(i));
            assertEq(uint256(v), result[i], names[i]);
            assertEq(uint256(f), flags[i], string.concat(names[i], " flags"));
        }
    }

    /// @notice Gas for both boundaries. The point of the sub-game is that this is paid at
    ///         most twice per dispute, not per step.
    function test_gas_succeeds() public {
        uint256 g0 = gasleft();
        game.nestedPreState(uint64(op[0]), uint64(a[0]), uint64(b[0]), uint64(cc[0]), imageProof);
        uint256 preGas = g0 - gasleft();

        bytes memory postState = _postState(0);
        bytes memory postProof = _postProof(0);
        g0 = gasleft();
        game.nestedResult(postState, postProof);
        uint256 resultGas = g0 - gasleft();

        emit log_named_uint("nestedPreState gas", preGas);
        emit log_named_uint("nestedResult   gas", resultGas);
        emit log_named_uint("both boundaries    ", preGas + resultGas);
    }

    /// @notice A branch that does not reconstruct the committed image must be rejected.
    ///
    ///         Without this check a disputant could supply a branch from some other memory
    ///         and derive a pre-state for a program that is not the committed co-processor —
    ///         which is to say, for arbitrary arithmetic.
    function test_nestedPreState_wrongImage_reverts() public {
        bytes memory bad = imageProof;
        bad[100] = bytes1(uint8(bad[100]) ^ 0xff);
        vm.expectRevert(FloatSubGame.ImageRootMismatch.selector);
        game.nestedPreState(uint64(op[0]), uint64(a[0]), uint64(b[0]), uint64(cc[0]), bad);
    }

    /// @notice An unknown operation selector must be rejected rather than silently treated
    ///         as addition — which is what the co-processor's `match` arm would do.
    function test_nestedPreState_unknownOp_reverts() public {
        vm.expectRevert(abi.encodeWithSelector(FloatSubGame.UnknownOperation.selector, uint64(0x7f)));
        game.nestedPreState(0x7f, uint64(a[0]), uint64(b[0]), 0, imageProof);
    }

    /// @notice A nested machine that has not halted proves nothing about the arithmetic, and
    ///         neither does one that faulted.
    function test_nestedResult_notExited_reverts() public {
        bytes memory postState = _postState(0);
        postState[81] = 0x00; // exited = false
        vm.expectRevert(FloatSubGame.SubGameNotExited.selector);
        game.nestedResult(postState, _postProof(0));
    }

    function test_nestedResult_faulted_reverts() public {
        bytes memory postState = _postState(0);
        postState[80] = 0x02; // exit code 2
        vm.expectRevert(abi.encodeWithSelector(FloatSubGame.SubGameFaulted.selector, uint8(2)));
        game.nestedResult(postState, _postProof(0));
    }

    /// @notice A result read against a memory branch that does not belong to the claimed
    ///         post-state must be rejected, or the result is unconstrained.
    function test_nestedResult_wrongProof_reverts() public {
        bytes memory bad = _postProof(0);
        bad[100] = bytes1(uint8(bad[100]) ^ 0xff);
        vm.expectRevert(FloatSubGame.MemProofMismatch.selector);
        game.nestedResult(_postState(0), bad);
    }

    /// @notice Different operands must give a different pre-state, or the commitment says
    ///         nothing about what is being disputed.
    function test_nestedPreState_bindsOperands_succeeds() public {
        bytes32 base = game.nestedPreState(uint64(op[0]), uint64(a[0]), uint64(b[0]), uint64(cc[0]), imageProof);
        assertTrue(base != game.nestedPreState(uint64(op[0]), uint64(a[0]) + 1, uint64(b[0]), uint64(cc[0]), imageProof));
        assertTrue(base != game.nestedPreState(uint64(op[0]), uint64(a[0]), uint64(b[0]) + 1, uint64(cc[0]), imageProof));
        assertTrue(base != game.nestedPreState(game.OP_MUL(), uint64(a[0]), uint64(b[0]), uint64(cc[0]), imageProof));
    }

    function _postState(uint256 i) internal view returns (bytes memory) {
        return abi.decode(vm.parseJson(json, string.concat(".postState[", vm.toString(i), "]")), (bytes));
    }

    function _postProof(uint256 i) internal view returns (bytes memory) {
        return abi.decode(vm.parseJson(json, string.concat(".postProof[", vm.toString(i), "]")), (bytes));
    }
}
